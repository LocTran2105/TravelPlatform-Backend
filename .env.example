# Bien moi truong local cho TravelPlatform-Backend - KHONG commit file .env
# Dong comment dau tien nay giup tranh loi BOM khi file bi luu bang Notepad/PowerShell.
# Cach dung: copy thanh file .env (cung cap voi pom.xml) roi dien gia tri that.

# ---- MySQL ----
DB_URL=jdbc:mysql://localhost:3306/travel_platform_db
DB_USERNAME=root
DB_PASSWORD=

# ---- Google Login (client id khong phai bi mat) ----
GOOGLE_CLIENT_ID=

# ---- Gmail SMTP (dung App Password, KHONG dung mat khau Gmail) ----
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Gemini (co the de trong cac key fallback) ----
GEMINI_API_KEY_PRIMARY=
GEMINI_API_KEY_FALLBACK_1=
GEMINI_API_KEY_FALLBACK_2=
GEMINI_API_KEY_FALLBACK_3=

# ---- OpenStreetMap (Photon/Overpass yeu cau User-Agent co thong tin lien he) ----
OSM_USER_AGENT=TravelPlatform-HCMUTE/1.0 (email-cua-ban@gmail.com)

# ---- Frontend (link trong email moi / chia se) ----
APP_FRONTEND_URL=http://localhost:5173
